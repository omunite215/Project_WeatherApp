# Copy to `.env` and fill in your key.
#
# Deliberately NOT prefixed with NEXT_PUBLIC_. Anything carrying that prefix is
# inlined into the JavaScript bundle and readable by anyone who opens devtools on
# the deployed site. This key is read only inside `lib/api/openweather.ts`, which
# imports `server-only` so the build fails if it is ever pulled into a client
# component.
#
# Get a free key at https://home.openweathermap.org/api_keys
# New keys can take up to two hours to activate.
OPENWEATHER_API_KEY=your_api_key_here
